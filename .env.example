# Copie:  cp .env.example .env
# Os NOMES são os mesmos local e em produção. Só os valores mudam.
# Toda IA na nuvem passa pela OpenRouter. Os modelos abaixo são a decisão inicial.

# =============================================================================
# Preencha
# =============================================================================

# OpenRouter — uma chave para embeddings, rerank e geração
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Opcional: chave só de uma camada (vazia = usa OPENROUTER_API_KEY).
# Ex.: geração no RunPod com GENERATION_API_KEY própria.
EMBEDDING_API_KEY=
RERANK_API_KEY=
GENERATION_API_KEY=

# =============================================================================
# Local já preenchido — em produção troque origem e segredos
# =============================================================================

ORIGIN=http://localhost
PUBLIC_ORIGIN=http://localhost
CADDY_EMAIL=admin@localhost

POSTGRES_USER=buscabase
POSTGRES_DB=buscabase
POSTGRES_PASSWORD=buscabase-local
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

CACHE_HMAC_SECRET=buscabase-local-hmac-key-not-for-production

USO_USER=uso
USO_PASSWORD=buscabase-local-uso

OPENROUTER_API_URL=https://openrouter.ai/api/v1

EMBEDDING_API_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=google/gemini-embedding-001
EMBEDDING_DIMENSION=3072
# 1 é o padrão seguro. Para o primeiro embed de ~5,6k blocos de prosa, use 8–16.
# Lotes grandes com timeout de 30s falham (read timed out).
EMBEDDING_BATCH_SIZE=1
EMBEDDING_TIMEOUT_SECONDS=120

RERANK_API_URL=https://openrouter.ai/api/v1
RERANK_MODEL=jina/jina-reranker-v3.5
RERANK_TIMEOUT_SECONDS=30
RERANK_CANDIDATES=24

GENERATION_API_URL=https://openrouter.ai/api/v1
GENERATION_MODEL=deepseek/deepseek-v4-flash
GENERATION_MAX_TOKENS=700
GENERATION_TEMPERATURE=0.2
GENERATION_TIMEOUT_SECONDS=120
GENERATION_EXTRA_BODY={"thinking":{"type":"disabled"},"reasoning":{"enabled":false,"effort":"none"}}
PERGUNTAR_ENABLED=true
PERGUNTAR_SOURCE_LIMIT=6
PERGUNTAR_ITEM_SOURCE_LIMIT=4
PERGUNTAR_PROSE_SOURCE_LIMIT=3

BNCC_DADOS_TAG=dados-2026.07.1
BNCC_PROSE_DIR=/data/prose

API_INTERNAL_URL=http://api:8000
REDIS_URL=redis://redis:6379/0
